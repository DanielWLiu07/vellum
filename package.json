{
  "name": "vitals",
  "version": "0.1.0",
  "private": false,
  "description": "A stateless, zero-knowledge secure document viewer microservice. HMAC capability tokens, server-side proxying, client-side pdf.js rendering with per-user watermarking and download prevention.",
  "license": "MIT",
  "author": "Daniel W Liu",
  "homepage": "https://github.com/DanielWLiu07/vellum",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielWLiu07/vellum.git"
  },
  "keywords": [
    "pdf",
    "viewer",
    "microservice",
    "watermark",
    "drm",
    "pdfjs",
    "secure-document",
    "capability-token",
    "nextjs"
  ],
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "sample:pdf": "node scripts/make-sample-pdf.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@napi-rs/canvas": "^0.1.100",
    "next": "^16.2.9",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "22.10.5",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.9"
  }
}
